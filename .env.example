# GMGN OpenAPI
GMGN_API_KEY=your_key_here
GMGN_PRIVATE_KEY=your_pem_key_here   # necessario apenas na Fase 2 (execucao)
GMGN_HOST=https://openapi.gmgn.ai

# Banco de dados (Railway fornece automaticamente)
DATABASE_URL=postgres://...

# Telegram
TELEGRAM_TOKEN=your_bot_token
TELEGRAM_CHAT=your_chat_id

# Filtros pre-watchlist (ajustaveis sem redeploy)
# Token descartado se QUALQUER criterio falhar
FILTER_RUG_MAX=0.15        # bundler ratio maximo (0.15 = 15%)
FILTER_RAT_MAX=0.20        # rat trader ratio maximo (0.20 = 20%)
FILTER_TOP10_MAX=0.80      # concentracao top 10 holders maxima
FILTER_SMART_MIN=1         # minimo de smart wallets (pelo menos 1)
FILTER_WASH_BLOCK=true     # bloquear wash trading

# Parametros de estrategia (Fase 2)
DUMP_THRESHOLD=0.30
MAX_MONITOR_MINUTOS=30
LIQ_MIN_USD=5000
BOT_ATIVO=false
BOT_VALOR_USD=10

# GMGN Filtered Trending (research-only, hipotese de demanda — PASSIVO)
GMGN_FILTERED_TRENDING_ENABLED=false        # liga o coletor (worker)
GMGN_FILTERED_TRENDING_POLL_SEC=60          # intervalo do poll por ciclo
GMGN_FILTERED_TRENDING_TIMEFRAMES=5m,1h     # abas de trending coletadas
GMGN_FILTERED_TRENDING_CHAIN=sol
GMGN_FILTERED_TRENDING_ORDER_BY=default
GMGN_FILTERED_TRENDING_MC_MIN=25000         # faixa operacional da hipotese
GMGN_FILTERED_TRENDING_MC_MAX=35000
GMGN_FILTERED_TRENDING_LIQ_MIN=5000
GMGN_FILTERED_TRENDING_FEE_MIN=1.0
GMGN_FILTERED_TRENDING_APPLY_FEE_FILTER=false  # gas_fee tem unidade incerta — off por padrao
GMGN_FILTERED_TRENDING_SCANNER_WINDOW_MIN=60   # janela de migrations p/ intersecao
GMGN_FILTERED_TRENDING_DEDUP_SEC=600           # max 1 label por mint+profile / 10min
GMGN_FILTERED_TRENDING_KEEP_OUTSIDE=false      # salvar tokens fora do scanner (diagnostico)
GMGN_FILTERED_TRENDING_OUTCOME_BATCH=500       # labels recalculados por ciclo
GMGN_FILTERED_TRENDING_RUN_ONCE=false          # true = um ciclo so (debug)
